import { ScrollView } from "std-widgets.slint";

struct FileEntry {
    path: string,
    checked: bool,
    note: string,
    state: int,
}

// app state: 0 idle, 1 ok, 2 warn
struct AppEntry {
    id: string,
    name: string,
    checked: bool,
    active: bool,
    sub: string,
    state: int,
}

// Fixed-size icon box: the glyph (11px) always has room, never clips.
component Icon inherits Rectangle {
    in property <string> glyph;
    in property <color> fg;
    in property <length> px: 11px;
    width: 20px;
    height: 20px;
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: glyph;
        color: fg;
        font-size: px;
        font-family: "JetBrainsMono Nerd Font";
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Accent checkbox — no default-blue widgets anywhere.
component Check inherits Rectangle {
    in property <bool> on;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> faint;
    callback toggled(bool);
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1px;
    border-color: on ? transparent : faint;
    background: on ? accent : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    Text {
        text: "\u{f00c}";
        color: on-accent;
        font-size: 10px;
        font-family: "JetBrainsMono Nerd Font";
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: on;
    }
}

// Themed text field: radius + accent focus ring follow the Omarchy theme.
// Hint floats BEHIND the input (both full width), so the input can never be
// squeezed to zero width and every click lands in the TextInput.
component Field inherits Rectangle {
    in-out property <string> value;
    in property <string> hint;
    in property <color> box-bg;
    in property <color> ink;
    in property <color> faint;
    in property <color> accent;
    in property <length> rad;
    in property <length> h: 34px;
    callback edited(string);
    height: h;
    border-radius: rad;
    background: box-bg;
    border-width: 1px;
    border-color: fi.has-focus ? accent : transparent;
    animate border-color { duration: 150ms; easing: ease-out; }
    clip: true;
    Text {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text: hint;
        color: faint;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        visible: value == "";
    }
    fi := TextInput {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text <=> value;
        color: ink;
        font-size: 12px;
        font-family: "JetBrainsMono Nerd Font";
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }
}

// file state: 0 synced, 1 modified, 2 new local, 3 repo-only
component FileRow inherits Rectangle {
    in property <string> fpath;
    in property <bool> fchecked;
    in property <string> fnote;
    in property <color> fdot;
    in property <color> ink;
    in property <color> faint;
    in property <color> accent;
    in property <color> on-accent;
    callback toggled(bool);
    height: 32px;
    HorizontalLayout {
        spacing: 9px;
        padding-left: 2px;
        padding-right: 2px;
        VerticalLayout {
            alignment: center;
            Check {
                on: fchecked;
                accent: accent;
                on-accent: on-accent;
                faint: faint;
                toggled(v) => { root.toggled(v); }
            }
        }
        Text {
            text: fpath;
            color: ink;
            font-size: 12px;
            font-family: "JetBrainsMono Nerd Font";
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: fdot;
            }
        }
        Text {
            text: fnote;
            color: faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <color> btn-bg;
    in property <color> btn-fg;
    in property <length> rad;
    in property <length> h: 34px;
    in property <bool> enabled: true;
    callback clicked();
    height: h;
    min-width: 72px;
    border-radius: rad;
    opacity: enabled ? 1 : 0.45;
    background: !enabled ? btn-bg : ta.pressed ? btn-bg.darker(0.15) : ta.has-hover ? btn-bg.brighter(0.08) : btn-bg;
    animate background { duration: 150ms; easing: ease-out; }
    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: enabled ? pointer : default;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        padding-left: 12px;
        padding-right: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: icon;
                fg: btn-fg;
                visible: icon != "";
            }
        }
        Text {
            text: label;
            color: btn-fg;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AppRow inherits Rectangle {
    in property <string> app-name;
    in property <string> app-sub;
    in property <bool> is-active;
    in property <bool> is-checked;
    in property <color> dot;
    in property <color> card-bg;
    in property <color> hover-bg;
    in property <color> ink;
    in property <color> faint;
    in property <color> accent;
    in property <color> on-accent;
    in property <length> rad;
    callback toggled(bool);
    callback select();
    height: 58px;
    border-radius: rad;
    // No background animation: the nested checkbox hover flapped has-hover
    // and restarted the fade (visible blinking). Hover is instant instead.
    background: is-active ? card-bg : row-ta.has-hover ? hover-bg.with-alpha(0.35) : transparent;
    row-ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Check {
                on: is-checked;
                accent: accent;
                on-accent: on-accent;
                faint: faint;
                toggled(v) => { root.toggled(v); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4px;
                background: dot;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: app-name;
                color: ink;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: app-sub;
                color: faint;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Config Sync";
    // Flexible instead of fixed: adapts to small displays / scaling.
    // Slint scales automatically with the display scale; min sizes keep
    // everything usable, stretches fill large screens.
    min-width: 660px;
    min-height: 540px;
    preferred-width: 980px;
    preferred-height: 720px;
    background: bg;

    // ---- live Omarchy theme, applied silently (no theme UI) ----
    in-out property <color> bg: #070e15;
    in-out property <color> surface: #20262c;
    in-out property <color> sel-bg: #2b333a;
    in-out property <color> console: #050b10;
    in-out property <color> ink: #e9efeb;
    in-out property <color> faint: #62676c;
    in-out property <color> accent: #97a6bb;
    in-out property <color> on-accent: #070e15;
    in-out property <color> ok: #82967f;
    in-out property <color> warn: #96937b;
    in-out property <color> bad: #857960;

    in-out property <length> radius: 10px;

    // ---- state ----
    in-out property <string> config-dir;
    in-out property <string> repo-dir;
    in-out property <string> remote-url;
    in-out property <string> restore-path;
    in-out property <string> sync-summary: "nothing scanned yet";
    in-out property <string> repo-status: "no repository configured";
    in-out property <string> github-line: "GitHub";
    in-out property <string> github-user: "";
    in-out property <bool> github-connected: false;
    in-out property <bool> show-repo-details: false;
    in-out property <string> sync-label: "Sync";
    in-out property <bool> show-welcome: true;
    in-out property <bool> welcome-dismissed: false;
    in-out property <string> welcome-detail: "";
    in-out property <bool> welcome-never: false;
    // In-app device login: code shown here while `gh` waits for the browser.
    in-out property <string> login-code: "";
    in-out property <bool> login-busy: false;
    // Subtle loading state: Braille spinner frames driven by a timer below.
    // Only visible during network sync (local ops stay instant).
    in-out property <bool> busy: false;
    in-out property <int> spin-frame: 0;
    property <[string]> spin-frames: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
    // Sidebar filter + section headers with counts.
    in-out property <string> app-filter: "";
    in-out property <string> fav-header: "FAVORITES";
    in-out property <string> other-header: "ALL APPS";
    // One-time fade-in, set from Rust after startup.
    in-out property <bool> ready: false;
    // Set by the one-shot boot timer; gates the startup scan.
    property <bool> booted: false;
    in-out property <string> log-text: "";
    in-out property <string> active-app: "zed";
    in-out property <string> app-title: "Zed";
    in-out property <string> app-detail: "pick apps on the left, then Scan";
    in-out property <string> push-label: "Push";
    in-out property <bool> download-mode: false;
    in-out property <bool> show-ssh-fix: false;
    // SSH readiness probe: 0 checking, 1 ok, 2 failed.
    in-out property <int> ssh-state: 0;
    in-out property <string> ssh-detail: "SSH: checking…";
    // Restore picker (Download mode): backups to choose from.
    in-out property <bool> show-restore: false;
    in-out property <string> restore-picked: "";
    in-out property <[FileEntry]> backup-items;
    in-out property <string> copy-label: "Copy";
    in-out property <[AppEntry]> fav-apps;
    in-out property <[AppEntry]> other-apps;
    in-out property <[FileEntry]> files;
    in-out property <[FileEntry]> repo-files;
    // Selection + confirm state (Safety: Apply never runs without preview + ok).
    in-out property <bool> has-selection: false;
    in-out property <bool> has-repo-selection: false;
    in-out property <bool> show-confirm: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-detail: "";
    in-out property <string> confirm-ok-label: "Backup + Apply";

    callback scan();
    callback activate(string);
    callback app-toggled(string, bool);
    callback app-filter-changed(string);
    callback file-toggled(int, bool);
    callback repo-file-toggled(int, bool);
    callback select-all();
    callback select-none();
    callback push(string);
    callback download();
    callback mode-toggle();
    callback restore(string);
    callback confirm-accept();
    callback confirm-cancel();
    // Minimal GitHub UX: ein Sync + ein Setup statt 5 Buttons.
    callback github-sync();
    callback repo-setup();
    callback fix-ssh-remote();
    callback toggle-details();
    callback github-relogin();
    callback toggle-restore();
    callback backup-pick(string);
    callback copy-log();
    callback copy-code();
    callback github-login();
    callback cancel-login();
    callback open-device-page();
    callback github-recheck();
    callback welcome-dismiss();
    // Old single-action callbacks stay wired for compatibility,
    // the UI no longer calls them directly.
    callback repo-fetch();
    callback repo-pull();
    callback repo-push();
    callback repo-clone();
    callback repo-init();
    callback theme-tick();
    callback auto-tick();
    // One-shot boot: fires once the event loop runs, so the startup scan
    // (and everything it invokes) can never be lost before `run()`.
    callback startup();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        opacity: ready ? 1 : 0;
        animate opacity { duration: 350ms; easing: ease-out; }

        Timer {
            interval: 2500ms;
            running: true;
            triggered => { root.theme-tick(); }
        }
        Timer {
            interval: 120ms;
            running: !root.booted;
            triggered => {
                root.booted = true;
                root.startup();
            }
        }
        Timer {
            interval: 30000ms;
            running: true;
            triggered => { root.auto-tick(); }
        }
        Timer {
            interval: 100ms;
            running: root.busy;
            triggered => {
                root.spin-frame = root.spin-frame + 1;
                if (root.spin-frame >= 10) {
                    root.spin-frame = 0;
                }
            }
        }

        // ---------- Welcome (first run): 1 action, the rest is automatic ----------
        if show-welcome: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    background: surface;
                    border-radius: radius;
                    min-width: 320px;
                    max-width: 480px;
                    horizontal-stretch: 0;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Icon { glyph: "\u{f1de}"; fg: accent; px: 26px; }
                        }
                        Text {
                            text: "Welcome to Config Sync";
                            color: ink;
                            font-size: 21px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Sign in once in the browser — repository, sync and backups then run quietly in the background.";
                            color: faint;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 4px; }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: "\u{f00c}"; fg: ok; }
                            }
                            Text {
                                text: "1. Sign in with GitHub in the browser";
                                color: ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: "\u{f00c}"; fg: ok; }
                            }
                            Text {
                                text: "2. Repository is created or cloned automatically";
                                color: ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: "\u{f00c}"; fg: ok; }
                            }
                            Text {
                                text: "3. Done — sync keeps running in the background";
                                color: ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: welcome-detail;
                            color: faint;
                            font-size: 11px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            visible: welcome-detail != "";
                        }
                        if login-code != "": VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "YOUR ONE-TIME CODE";
                                color: faint;
                                font-size: 10px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: login-code;
                                color: ink;
                                font-size: 28px;
                                font-weight: 800;
                                font-family: "JetBrainsMono Nerd Font";
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "type it at the opened page, then approve";
                                color: faint;
                                font-size: 11px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle { height: 4px; }
                        ActionButton {
                            label: github-connected ? "Continue to app" : (login-busy ? "Waiting for browser…" : "Sign in in the browser");
                            icon: "\u{f09b}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            h: 40px;
                            horizontal-stretch: 1;
                            enabled: !login-busy;
                            clicked => { github-login(); }
                        }
                        if login-busy: HorizontalLayout {
                            spacing: 8px;
                            if login-code != "": ActionButton {
                                label: "Open browser again";
                                icon: "\u{f08e}";
                                btn-bg: bg;
                                btn-fg: ink;
                                rad: radius;
                                h: 36px;
                                horizontal-stretch: 1;
                                clicked => { open-device-page(); }
                            }
                            ActionButton {
                                label: "Cancel";
                                icon: "\u{f00d}";
                                btn-bg: transparent;
                                btn-fg: faint;
                                rad: radius;
                                h: 36px;
                                horizontal-stretch: 1;
                                clicked => { cancel-login(); }
                            }
                        }
                        ActionButton {
                            label: "I'm signed in — continue";
                            icon: "\u{f021}";
                            btn-bg: bg;
                            btn-fg: ink;
                            rad: radius;
                            h: 36px;
                            horizontal-stretch: 1;
                            clicked => { github-recheck(); }
                        }
                        ActionButton {
                            label: "Start offline";
                            icon: "";
                            btn-bg: transparent;
                            btn-fg: faint;
                            rad: radius;
                            h: 32px;
                            horizontal-stretch: 1;
                            clicked => { welcome-dismiss(); }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Check {
                                    on: welcome-never;
                                    accent: accent;
                                    on-accent: on-accent;
                                    faint: faint;
                                    toggled(v) => { welcome-never = v; }
                                }
                            }
                            Text {
                                text: "Don't show again";
                                color: faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ---------- Haupt-UI ----------
        if !show-welcome: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            // header: name + aggregate sync state, nothing else
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon { glyph: "\u{f1de}"; fg: accent; px: 15px; }
                }
                Text {
                    text: "Config Sync";
                    color: ink;
                    font-size: 20px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: sync-summary;
                    color: faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // GitHub: one status line + Sync, details only on demand
            Rectangle {
                background: surface;
                border-radius: radius;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4px;
                                background: github-connected ? ok : warn;
                            }
                        }
                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: github-line;
                                color: ink;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: repo-status;
                                color: faint;
                                font-size: 11px;
                                font-family: "JetBrainsMono Nerd Font";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if busy: VerticalLayout {
                            alignment: center;
                            Text {
                                text: spin-frames[spin-frame];
                                color: accent;
                                font-size: 15px;
                                font-family: "JetBrainsMono Nerd Font";
                                vertical-alignment: center;
                            }
                        }
                        ActionButton {
                            label: push-label;
                            icon: "\u{f093}";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 32px;
                            enabled: has-selection && !busy && !download-mode;
                            clicked => { push(active-app); }
                        }
                        ActionButton {
                            label: sync-label;
                            icon: "\u{f021}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            h: 32px;
                            enabled: !busy;
                            clicked => { github-sync(); }
                        }
                        ActionButton {
                            label: show-repo-details ? "Less" : "Details";
                            icon: show-repo-details ? "\u{f077}" : "\u{f078}";
                            btn-bg: bg;
                            btn-fg: ink;
                            rad: radius;
                            h: 32px;
                            clicked => { toggle-details(); }
                        }
                    }
                    if show-repo-details: VerticalLayout {
                        spacing: 8px;
                        // Auth: who + SSH state on the left, web login on the right.
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 4px;
                                    background: ssh-state == 1 ? ok : ssh-state == 2 ? warn : faint;
                                }
                            }
                            VerticalLayout {
                                spacing: 1px;
                                horizontal-stretch: 1;
                                Text {
                                    text: github-connected ? "Signed in — sync just works" : "Not signed in yet";
                                    color: ink;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: ssh-detail;
                                    color: faint;
                                    font-size: 11px;
                                    font-family: "JetBrainsMono Nerd Font";
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            ActionButton {
                                label: login-busy ? "Cancel" : "Login via Web";
                                icon: login-busy ? "\u{f00d}" : "\u{f0ac}";
                                btn-bg: bg;
                                btn-fg: ink;
                                rad: radius;
                                h: 32px;
                                enabled: !busy;
                                clicked => {
                                    if (login-busy) {
                                        cancel-login();
                                    } else {
                                        github-relogin();
                                    }
                                }
                            }
                        }
                        if login-code != "": HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: login-code;
                                color: ink;
                                font-size: 22px;
                                font-weight: 800;
                                font-family: "JetBrainsMono Nerd Font";
                                vertical-alignment: center;
                            }
                            ActionButton {
                                label: "";
                                icon: "\u{f0c5}";
                                btn-bg: transparent;
                                btn-fg: faint;
                                rad: radius;
                                h: 30px;
                                clicked => { copy-code(); }
                            }
                        }
                        // Repository: local path is fixed (~/config-data),
                        // only the GitHub URL is ever needed.
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 1;
                                Text { text: "GITHUB URL (FOR CLONE)"; color: faint; font-size: 10px; font-weight: 700; }
                                Field {
                                    value <=> remote-url;
                                    hint: "git@github.com:me/config-data.git";
                                    box-bg: bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    rad: radius;
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                ActionButton {
                                    label: "Set up";
                                    icon: "\u{f067}";
                                    btn-bg: bg;
                                    btn-fg: ink;
                                    rad: radius;
                                    h: 34px;
                                    enabled: !busy;
                                    clicked => { repo-setup(); }
                                }
                            }
                        }
                        if show-ssh-fix: HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Remote uses HTTPS — SSH needs no password.";
                                color: faint;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            ActionButton {
                                label: "Use SSH";
                                icon: "\u{f084}";
                                btn-bg: bg;
                                btn-fg: ink;
                                rad: radius;
                                h: 32px;
                                enabled: !busy;
                                clicked => { fix-ssh-remote(); }
                            }
                        }
                    }
                }
            }

            // content: sidebar + main (flexible for small displays)
            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                Rectangle {
                    background: surface;
                    border-radius: radius;
                    preferred-width: 250px;
                    min-width: 210px;
                    max-width: 320px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Field {
                            value <=> app-filter;
                            hint: "Filter apps…";
                            box-bg: bg;
                            ink: ink;
                            faint: faint;
                            accent: accent;
                            rad: radius;
                            h: 32px;
                            edited(v) => { root.app-filter-changed(v); }
                        }
                        // One scroll region for everything: favorites stay
                        // pinned on top but never steal space from the rest.
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: fav-header; color: faint; font-size: 11px; font-weight: 700; }
                                for ae in fav-apps: AppRow {
                                    app-name: ae.name;
                                    app-sub: ae.sub;
                                    is-active: ae.active;
                                    is-checked: ae.checked;
                                    dot: ae.state == 1 ? ok : ae.state == 2 ? warn : faint;
                                    card-bg: sel-bg;
                                    hover-bg: sel-bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    rad: radius;
                                    toggled(v) => { root.app-toggled(ae.id, v); }
                                    select => { root.activate(ae.id); }
                                }
                                Text { text: other-header; color: faint; font-size: 11px; font-weight: 700; }
                                for ae in other-apps: AppRow {
                                    app-name: ae.name;
                                    app-sub: ae.sub;
                                    is-active: ae.active;
                                    is-checked: ae.checked;
                                    dot: ae.state == 1 ? ok : ae.state == 2 ? warn : faint;
                                    card-bg: sel-bg;
                                    hover-bg: sel-bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    rad: radius;
                                    toggled(v) => { root.app-toggled(ae.id, v); }
                                    select => { root.activate(ae.id); }
                                }
                                if fav-apps.length == 0 && other-apps.length == 0: Text {
                                    text: "No apps match this filter.";
                                    color: faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        ActionButton {
                            label: "Scan";
                            icon: "\u{f002}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            horizontal-stretch: 1;
                            enabled: !busy;
                            clicked => { scan(); }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 300px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: download-mode ? "Apply from repository" : app-title;
                            color: ink;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: download-mode ? "" : app-detail;
                            color: faint;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ActionButton {
                            label: download-mode ? "Upload" : "Download";
                            icon: download-mode ? "\u{f093}" : "\u{f019}";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 30px;
                            clicked => { mode-toggle(); }
                        }
                    }
                    if !download-mode: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "FILES"; color: faint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        // Legend: dot colors carry meaning, so name them once.
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 7px; height: 7px; border-radius: 3px; background: ok; }
                        }
                        Text { text: "synced"; color: faint; font-size: 11px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 7px; height: 7px; border-radius: 3px; background: warn; }
                        }
                        Text { text: "changed"; color: faint; font-size: 11px; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Rectangle { width: 7px; height: 7px; border-radius: 3px; background: accent; }
                        }
                        Text { text: "new"; color: faint; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            label: "All";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 30px;
                            enabled: !busy && files.length > 0;
                            clicked => { select-all(); }
                        }
                        ActionButton {
                            label: "None";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 30px;
                            enabled: !busy && files.length > 0;
                            clicked => { select-none(); }
                        }
                    }
                    if !download-mode: Rectangle {
                        background: surface;
                        border-radius: radius;
                        vertical-stretch: 1;
                        min-height: 120px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                if files.length == 0: Text {
                                    text: "Nothing scanned yet — pick apps on the left, then Scan.";
                                    color: faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for fe[idx] in files: FileRow {
                                    fpath: fe.path;
                                    fchecked: fe.checked;
                                    fnote: fe.note;
                                    fdot: fe.state == 0 ? ok : fe.state == 1 ? warn : fe.state == 2 ? accent : faint;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    toggled(v) => { file-toggled(idx, v); }
                                }
                            }
                        }
                    }
                    if download-mode: Rectangle {
                        background: surface;
                        border-radius: radius;
                        vertical-stretch: 1;
                        min-height: 120px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                if repo-files.length == 0: Text {
                                    text: "No repository yet — open Details, then Set up.";
                                    color: faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for re[ridx] in repo-files: FileRow {
                                    fpath: re.path;
                                    fchecked: re.checked;
                                    fnote: re.note;
                                    fdot: re.state == 0 ? ok : warn;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    toggled(v) => { repo-file-toggled(ridx, v); }
                                }
                            }
                        }
                    }
                    if download-mode: HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            label: "Apply to device";
                            icon: "\u{f019}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            enabled: has-repo-selection && !busy;
                            clicked => { download(); }
                        }
                        ActionButton {
                            label: show-restore ? "Hide restore" : "Restore…";
                            icon: "\u{f0e2}";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            enabled: !busy;
                            clicked => { toggle-restore(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if download-mode: Text {
                        text: "Each app is backed up first — undo anytime via Restore below.";
                        color: faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    if download-mode && show-restore: Rectangle {
                        background: surface;
                        border-radius: radius;
                        clip: true;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            Text { text: "BACKUPS"; color: faint; font-size: 11px; font-weight: 700; }
                            if backup-items.length == 0: Text {
                                text: "No backups yet — they appear after your first Apply.";
                                color: faint;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            for b in backup-items: Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: restore-picked == b.path ? sel-bg : transparent;
                                TouchArea {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => { backup-pick(b.path); }
                                }
                                HorizontalLayout {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: b.path;
                                        color: ink;
                                        font-size: 12px;
                                        font-family: "JetBrainsMono Nerd Font";
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: b.note;
                                        color: faint;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Field {
                                    value <=> restore-path;
                                    hint: "pick above or paste .bak path";
                                    box-bg: bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    rad: radius;
                                    h: 32px;
                                    horizontal-stretch: 1;
                                }
                                ActionButton {
                                    label: "Restore";
                                    icon: "\u{f0e2}";
                                    btn-bg: bg;
                                    btn-fg: ink;
                                    rad: radius;
                                    h: 32px;
                                    enabled: !busy && restore-path != "";
                                    clicked => { restore(restore-path); }
                                }
                            }
                        }
                    }
                }
            }

            // log (kompakt, damit kleine Displays alles sehen)
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { glyph: "\u{f120}"; fg: faint; px: 12px; }
                }
                Text { text: "LOG"; color: faint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    label: copy-label;
                    icon: "\u{f0c5}";
                    btn-bg: surface;
                    btn-fg: ink;
                    rad: radius;
                    h: 26px;
                    enabled: log-text != "";
                    clicked => { copy-log(); }
                }
            }
            Rectangle {
                background: console;
                border-radius: radius;
                min-height: 64px;
                max-height: 110px;
                clip: true;
                ScrollView {
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: log-text;
                            color: ink;
                            font-family: "JetBrainsMono Nerd Font";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
    // ---------- Confirm overlay (preview -> confirm -> backup) ----------
    // Direct child of the Window (not inside the layout), so it can cover all.
    // Modal for destructive Apply: names what will change and the recovery.
    if show-confirm: confirm-root := Rectangle {
        background: bg.with-alpha(0.6);
        TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clicked => { confirm-cancel(); }
        }
        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    background: surface;
                    border-radius: radius;
                    min-width: 320px;
                    max-width: 460px;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        Text {
                            text: confirm-title;
                            color: ink;
                            font-size: 16px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        Text {
                            text: confirm-detail;
                            color: ink;
                            font-size: 12px;
                            font-family: "JetBrainsMono Nerd Font";
                            wrap: word-wrap;
                        }
                        Text {
                            text: "A backup (.bak + time) is created first — restore from Details if needed.";
                            color: faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                label: "Cancel";
                                btn-bg: bg;
                                btn-fg: ink;
                                rad: radius;
                                h: 36px;
                                horizontal-stretch: 1;
                                clicked => { confirm-cancel(); }
                            }
                            ActionButton {
                                label: confirm-ok-label;
                                icon: "\u{f00c}";
                                btn-bg: accent;
                                btn-fg: on-accent;
                                rad: radius;
                                h: 36px;
                                horizontal-stretch: 1;
                                clicked => { confirm-accept(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
