import { ScrollView } from "std-widgets.slint";

struct FileEntry {
    path: string,
    checked: bool,
    note: string,
    state: int,
}

// app state: 0 idle, 1 ok, 2 warn
struct AppEntry {
    id: string,
    name: string,
    checked: bool,
    active: bool,
    sub: string,
    state: int,
}

// Fixed-size icon box: the glyph (11px) always has room, never clips.
component Icon inherits Rectangle {
    in property <string> glyph;
    in property <color> fg;
    in property <length> px: 11px;
    width: 20px;
    height: 20px;
    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: glyph;
        color: fg;
        font-size: px;
        font-family: "JetBrainsMono Nerd Font";
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Accent checkbox — no default-blue widgets anywhere.
component Check inherits Rectangle {
    in property <bool> on;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> faint;
    callback toggled(bool);
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: 1px;
    border-color: on ? transparent : faint;
    background: on ? accent : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    Text {
        text: "\u{f00c}";
        color: on-accent;
        font-size: 10px;
        font-family: "JetBrainsMono Nerd Font";
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: on;
    }
}

// Themed text field: radius + accent focus ring follow the Omarchy theme.
// Hint floats BEHIND the input (both full width), so the input can never be
// squeezed to zero width and every click lands in the TextInput.
component Field inherits Rectangle {
    in-out property <string> value;
    in property <string> hint;
    in property <color> box-bg;
    in property <color> ink;
    in property <color> faint;
    in property <color> accent;
    in property <length> rad;
    in property <length> h: 34px;
    callback edited(string);
    height: h;
    border-radius: rad;
    background: box-bg;
    border-width: 1px;
    border-color: fi.has-focus ? accent : transparent;
    animate border-color { duration: 150ms; easing: ease-out; }
    clip: true;
    Text {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text: hint;
        color: faint;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        visible: value == "";
    }
    fi := TextInput {
        x: 10px;
        y: 0;
        width: parent.width - 20px;
        height: parent.height;
        text <=> value;
        color: ink;
        font-size: 12px;
        font-family: "JetBrainsMono Nerd Font";
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }
}

// file state: 0 synced, 1 modified, 2 new local, 3 repo-only
component FileRow inherits Rectangle {
    in property <string> fpath;
    in property <bool> fchecked;
    in property <string> fnote;
    in property <color> fdot;
    in property <color> ink;
    in property <color> faint;
    in property <color> accent;
    in property <color> on-accent;
    callback toggled(bool);
    height: 32px;
    HorizontalLayout {
        spacing: 9px;
        padding-left: 2px;
        padding-right: 2px;
        VerticalLayout {
            alignment: center;
            Check {
                on: fchecked;
                accent: accent;
                on-accent: on-accent;
                faint: faint;
                toggled(v) => { root.toggled(v); }
            }
        }
        Text {
            text: fpath;
            color: ink;
            font-size: 12px;
            font-family: "JetBrainsMono Nerd Font";
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: fdot;
            }
        }
        Text {
            text: fnote;
            color: faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <color> btn-bg;
    in property <color> btn-fg;
    in property <length> rad;
    in property <length> h: 34px;
    callback clicked();
    height: h;
    min-width: 72px;
    border-radius: rad;
    background: ta.pressed ? btn-bg.darker(0.15) : ta.has-hover ? btn-bg.brighter(0.08) : btn-bg;
    animate background { duration: 150ms; easing: ease-out; }
    ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        padding-left: 12px;
        padding-right: 12px;
        VerticalLayout {
            alignment: center;
            Icon {
                glyph: icon;
                fg: btn-fg;
                visible: icon != "";
            }
        }
        Text {
            text: label;
            color: btn-fg;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component AppRow inherits Rectangle {
    in property <string> app-name;
    in property <string> app-sub;
    in property <bool> is-active;
    in property <bool> is-checked;
    in property <color> dot;
    in property <color> card-bg;
    in property <color> hover-bg;
    in property <color> ink;
    in property <color> faint;
    in property <color> accent;
    in property <color> on-accent;
    in property <length> rad;
    callback toggled(bool);
    callback select();
    height: 58px;
    border-radius: rad;
    background: is-active ? card-bg : row-ta.has-hover ? hover-bg.with-alpha(0.35) : transparent;
    animate background { duration: 150ms; easing: ease-out; }
    row-ta := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.select(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Check {
                on: is-checked;
                accent: accent;
                on-accent: on-accent;
                faint: faint;
                toggled(v) => { root.toggled(v); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4px;
                background: dot;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: app-name;
                color: ink;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: app-sub;
                color: faint;
                font-size: 11px;
                overflow: elide;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Config Sync";
    // Flexible instead of fixed: adapts to small displays / scaling.
    // Slint scales automatically with the display scale; min sizes keep
    // everything usable, stretches fill large screens.
    min-width: 660px;
    min-height: 540px;
    preferred-width: 980px;
    preferred-height: 720px;
    background: bg;

    // ---- live Omarchy theme, applied silently (no theme UI) ----
    in-out property <color> bg: #070e15;
    in-out property <color> surface: #20262c;
    in-out property <color> sel-bg: #2b333a;
    in-out property <color> console: #050b10;
    in-out property <color> ink: #e9efeb;
    in-out property <color> faint: #62676c;
    in-out property <color> accent: #97a6bb;
    in-out property <color> on-accent: #070e15;
    in-out property <color> ok: #82967f;
    in-out property <color> warn: #96937b;
    in-out property <color> bad: #857960;

    in-out property <length> radius: 10px;

    // ---- state ----
    in-out property <string> config-dir;
    in-out property <string> repo-dir;
    in-out property <string> remote-url;
    in-out property <string> restore-path;
    in-out property <string> sync-summary: "nothing scanned yet";
    in-out property <string> repo-status: "no repository configured";
    in-out property <string> github-line: "GitHub";
    in-out property <string> github-user: "";
    in-out property <bool> github-connected: false;
    in-out property <bool> show-repo-details: false;
    in-out property <string> sync-label: "Sync";
    in-out property <bool> show-welcome: true;
    in-out property <bool> welcome-dismissed: false;
    in-out property <string> welcome-detail: "";
    // Subtle loading state: Braille spinner frames driven by a timer below.
    // Only visible during network sync (local ops stay instant).
    in-out property <bool> busy: false;
    in-out property <int> spin-frame: 0;
    property <[string]> spin-frames: ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
    // Sidebar filter + section headers with counts.
    in-out property <string> app-filter: "";
    in-out property <string> fav-header: "FAVORITES";
    in-out property <string> other-header: "ALL APPS";
    // One-time fade-in, set from Rust after startup.
    in-out property <bool> ready: false;
    in-out property <string> log-text: "";
    in-out property <string> active-app: "zed";
    in-out property <string> app-title: "Zed";
    in-out property <string> app-detail: "pick apps on the left, then Scan";
    in-out property <string> push-label: "Push";
    in-out property <string> apply-label: "Apply";
    in-out property <bool> download-mode: false;
    in-out property <[AppEntry]> fav-apps;
    in-out property <[AppEntry]> other-apps;
    in-out property <[FileEntry]> files;
    in-out property <[FileEntry]> repo-files;

    callback scan();
    callback activate(string);
    callback app-toggled(string, bool);
    callback app-filter-changed(string);
    callback file-toggled(int, bool);
    callback repo-file-toggled(int, bool);
    callback select-all();
    callback select-none();
    callback push(string);
    callback apply(string);
    callback download();
    callback mode-toggle();
    callback restore(string);
    // Minimal GitHub UX: ein Sync + ein Setup statt 5 Buttons.
    callback github-sync();
    callback repo-setup();
    callback github-login();
    callback github-recheck();
    callback welcome-dismiss();
    // Old single-action callbacks stay wired for compatibility,
    // the UI no longer calls them directly.
    callback repo-fetch();
    callback repo-pull();
    callback repo-push();
    callback repo-clone();
    callback repo-init();
    callback theme-tick();
    callback auto-tick();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        opacity: ready ? 1 : 0;
        animate opacity { duration: 350ms; easing: ease-out; }

        Timer {
            interval: 2500ms;
            running: true;
            triggered => { root.theme-tick(); }
        }
        Timer {
            interval: 30000ms;
            running: true;
            triggered => { root.auto-tick(); }
        }
        Timer {
            interval: 100ms;
            running: root.busy;
            triggered => {
                root.spin-frame = root.spin-frame + 1;
                if (root.spin-frame >= 10) {
                    root.spin-frame = 0;
                }
            }
        }

        // ---------- Welcome (first run): 1 action, the rest is automatic ----------
        if show-welcome: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    background: surface;
                    border-radius: radius;
                    min-width: 320px;
                    max-width: 480px;
                    horizontal-stretch: 0;
                    VerticalLayout {
                        padding: 24px;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Icon { glyph: "\u{f1de}"; fg: accent; px: 26px; }
                        }
                        Text {
                            text: "Welcome to Config Sync";
                            color: ink;
                            font-size: 21px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Sign in once in the browser — repository, sync and backups then run quietly in the background.";
                            color: faint;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 4px; }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: "\u{f00c}"; fg: ok; }
                            }
                            Text {
                                text: "1. Sign in with GitHub in the browser";
                                color: ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: "\u{f00c}"; fg: ok; }
                            }
                            Text {
                                text: "2. Repository is created or cloned automatically";
                                color: ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon { glyph: "\u{f00c}"; fg: ok; }
                            }
                            Text {
                                text: "3. Done — sync keeps running in the background";
                                color: ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                        Text {
                            text: welcome-detail;
                            color: faint;
                            font-size: 11px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            visible: welcome-detail != "";
                        }
                        Rectangle { height: 4px; }
                        ActionButton {
                            label: "Sign in in the browser";
                            icon: "\u{f09b}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            h: 40px;
                            horizontal-stretch: 1;
                            clicked => { github-login(); }
                        }
                        ActionButton {
                            label: "I'm signed in — continue";
                            icon: "\u{f021}";
                            btn-bg: bg;
                            btn-fg: ink;
                            rad: radius;
                            h: 36px;
                            horizontal-stretch: 1;
                            clicked => { github-recheck(); }
                        }
                        ActionButton {
                            label: "Start offline";
                            icon: "";
                            btn-bg: transparent;
                            btn-fg: faint;
                            rad: radius;
                            h: 32px;
                            horizontal-stretch: 1;
                            clicked => { welcome-dismiss(); }
                        }
                    }
                }
            }
        }

        // ---------- Haupt-UI ----------
        if !show-welcome: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            // header: name + aggregate sync state, nothing else
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Icon { glyph: "\u{f1de}"; fg: accent; px: 15px; }
                }
                Text {
                    text: "Config Sync";
                    color: ink;
                    font-size: 20px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: sync-summary;
                    color: faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // GitHub: one status line + Sync, details only on demand
            Rectangle {
                background: surface;
                border-radius: radius;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                border-radius: 4px;
                                background: github-connected ? ok : warn;
                            }
                        }
                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: github-line;
                                color: ink;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: repo-status;
                                color: faint;
                                font-size: 11px;
                                font-family: "JetBrainsMono Nerd Font";
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if busy: VerticalLayout {
                            alignment: center;
                            Text {
                                text: spin-frames[spin-frame];
                                color: accent;
                                font-size: 15px;
                                font-family: "JetBrainsMono Nerd Font";
                                vertical-alignment: center;
                            }
                        }
                        ActionButton {
                            label: sync-label;
                            icon: "\u{f021}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            h: 32px;
                            clicked => { github-sync(); }
                        }
                        ActionButton {
                            label: show-repo-details ? "Less" : "Details";
                            icon: show-repo-details ? "\u{f077}" : "\u{f078}";
                            btn-bg: bg;
                            btn-fg: ink;
                            rad: radius;
                            h: 32px;
                            clicked => { show-repo-details = !show-repo-details; }
                        }
                    }
                    if show-repo-details: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 2;
                                min-width: 140px;
                                Text { text: "LOCAL PATH"; color: faint; font-size: 10px; font-weight: 700; }
                                Field {
                                    value <=> repo-dir;
                                    hint: "~/config-data";
                                    box-bg: bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    rad: radius;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                horizontal-stretch: 3;
                                min-width: 180px;
                                Text { text: "GITHUB URL (CLONE ONLY)"; color: faint; font-size: 10px; font-weight: 700; }
                                Field {
                                    value <=> remote-url;
                                    hint: "git@github.com:me/config-data.git";
                                    box-bg: bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    rad: radius;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                label: "Set up";
                                icon: "\u{f067}";
                                btn-bg: bg;
                                btn-fg: ink;
                                rad: radius;
                                h: 34px;
                                horizontal-stretch: 1;
                                clicked => { repo-setup(); }
                            }
                            Field {
                                value <=> restore-path;
                                hint: ".../zed.bak.123";
                                box-bg: bg;
                                ink: ink;
                                faint: faint;
                                accent: accent;
                                rad: radius;
                                h: 34px;
                                horizontal-stretch: 2;
                            }
                            ActionButton {
                                label: "Restore";
                                icon: "\u{f0e2}";
                                btn-bg: bg;
                                btn-fg: ink;
                                rad: radius;
                                h: 34px;
                                clicked => { restore(restore-path); }
                            }
                        }
                    }
                }
            }

            // content: sidebar + main (flexible for small displays)
            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 1;

                Rectangle {
                    background: surface;
                    border-radius: radius;
                    preferred-width: 250px;
                    min-width: 210px;
                    max-width: 320px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Field {
                            value <=> app-filter;
                            hint: "Filter apps…";
                            box-bg: bg;
                            ink: ink;
                            faint: faint;
                            accent: accent;
                            rad: radius;
                            h: 32px;
                            edited(v) => { root.app-filter-changed(v); }
                        }
                        // One scroll region for everything: favorites stay
                        // pinned on top but never steal space from the rest.
                        ScrollView {
                            vertical-stretch: 1;
                            min-height: 120px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: fav-header; color: faint; font-size: 11px; font-weight: 700; }
                                for ae in fav-apps: AppRow {
                                    app-name: ae.name;
                                    app-sub: ae.sub;
                                    is-active: ae.active;
                                    is-checked: ae.checked;
                                    dot: ae.state == 1 ? ok : ae.state == 2 ? warn : faint;
                                    card-bg: sel-bg;
                                    hover-bg: sel-bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    rad: radius;
                                    toggled(v) => { root.app-toggled(ae.id, v); }
                                    select => { root.activate(ae.id); }
                                }
                                Text { text: other-header; color: faint; font-size: 11px; font-weight: 700; }
                                for ae in other-apps: AppRow {
                                    app-name: ae.name;
                                    app-sub: ae.sub;
                                    is-active: ae.active;
                                    is-checked: ae.checked;
                                    dot: ae.state == 1 ? ok : ae.state == 2 ? warn : faint;
                                    card-bg: sel-bg;
                                    hover-bg: sel-bg;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    rad: radius;
                                    toggled(v) => { root.app-toggled(ae.id, v); }
                                    select => { root.activate(ae.id); }
                                }
                                if fav-apps.length == 0 && other-apps.length == 0: Text {
                                    text: "No apps match this filter.";
                                    color: faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        ActionButton {
                            label: "Scan";
                            icon: "\u{f002}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            horizontal-stretch: 1;
                            clicked => { scan(); }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 300px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: download-mode ? "Apply from repository" : app-title;
                            color: ink;
                            font-size: 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: download-mode ? "" : app-detail;
                            color: faint;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ActionButton {
                            label: download-mode ? "Upload" : "Download";
                            icon: download-mode ? "\u{f093}" : "\u{f019}";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 30px;
                            clicked => { mode-toggle(); }
                        }
                    }
                    if !download-mode: HorizontalLayout {
                        spacing: 8px;
                        Text { text: "FILES"; color: faint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            label: "All";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 30px;
                            clicked => { select-all(); }
                        }
                        ActionButton {
                            label: "None";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            h: 30px;
                            clicked => { select-none(); }
                        }
                    }
                    if !download-mode: Rectangle {
                        background: surface;
                        border-radius: radius;
                        vertical-stretch: 1;
                        min-height: 120px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                if files.length == 0: Text {
                                    text: "Nothing scanned yet — pick apps on the left, then Scan.";
                                    color: faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for fe[idx] in files: FileRow {
                                    fpath: fe.path;
                                    fchecked: fe.checked;
                                    fnote: fe.note;
                                    fdot: fe.state == 0 ? ok : fe.state == 1 ? warn : fe.state == 2 ? accent : faint;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    toggled(v) => { file-toggled(idx, v); }
                                }
                            }
                        }
                    }
                    if !download-mode: HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            label: push-label;
                            icon: "\u{f093}";
                            btn-bg: surface;
                            btn-fg: ink;
                            rad: radius;
                            clicked => { push(active-app); }
                        }
                        ActionButton {
                            label: apply-label;
                            icon: "\u{f00c}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            clicked => { apply(active-app); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if download-mode: Rectangle {
                        background: surface;
                        border-radius: radius;
                        vertical-stretch: 1;
                        min-height: 120px;
                        clip: true;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                if repo-files.length == 0: Text {
                                    text: "No repository yet — open Details, then Set up.";
                                    color: faint;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                for re[ridx] in repo-files: FileRow {
                                    fpath: re.path;
                                    fchecked: re.checked;
                                    fnote: re.note;
                                    fdot: re.state == 0 ? ok : warn;
                                    ink: ink;
                                    faint: faint;
                                    accent: accent;
                                    on-accent: on-accent;
                                    toggled(v) => { repo-file-toggled(ridx, v); }
                                }
                            }
                        }
                    }
                    if download-mode: HorizontalLayout {
                        spacing: 8px;
                        ActionButton {
                            label: "Apply all";
                            icon: "\u{f019}";
                            btn-bg: accent;
                            btn-fg: on-accent;
                            rad: radius;
                            clicked => { download(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            // log (kompakt, damit kleine Displays alles sehen)
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { glyph: "\u{f120}"; fg: faint; px: 12px; }
                }
                Text { text: "LOG"; color: faint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
            }
            Rectangle {
                background: console;
                border-radius: radius;
                min-height: 64px;
                max-height: 110px;
                clip: true;
                ScrollView {
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: log-text;
                            color: ink;
                            font-family: "JetBrainsMono Nerd Font";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
